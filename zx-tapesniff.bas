10 REM ═══════════════════════════════════════
20 REM  ZX-TAPESNIFF V1.0
30 REM  TAPE INTERFACE ANALYZER
40 REM  GITHUB.COM/BAD-ANTICS | NULLSEC RETRO
50 REM ═══════════════════════════════════════
60 REM
100 CLS
110 PRINT AT 0,0; INK 5;"╔════════════════════════════════╗"
120 PRINT AT 1,0; INK 5;"║"; INK 7;" ZX-TAPESNIFF V1.0     "; INK 5;"     ║"
130 PRINT AT 2,0; INK 5;"║"; INK 6;" TAPE DATA ANALYZER     "; INK 5;"    ║"
140 PRINT AT 3,0; INK 5;"╚════════════════════════════════╝"
150 PRINT
160 PRINT INK 7;"TAPE HEADER FORMAT:"
170 PRINT "────────────────────"
180 PRINT INK 4;"TYPE  "; INK 7;"DESCRIPTION"
190 PRINT INK 4;"0     "; INK 7;"PROGRAM"
200 PRINT INK 4;"1     "; INK 7;"NUMBER ARRAY"
210 PRINT INK 4;"2     "; INK 7;"STRING ARRAY"
220 PRINT INK 4;"3     "; INK 7;"CODE/BYTES"
230 PRINT
240 PRINT INK 2;"LISTENING FOR TAPE DATA..."
250 PRINT INK 6;"(PRESS PLAY ON TAPE)"
260 PRINT
300 REM ── MONITOR EAR PORT ──
310 DIM S(256)
320 LET SAMPLES=0
330 LET HIGHS=0: LET LOWS=0
340 LET LASTVAL=0
350 LET TRANSITIONS=0
360 FOR I=1 TO 256
370 LET V=IN 254
380 LET BIT=INT(V/64)-2*INT(V/128)
390 LET S(I)=BIT
400 IF BIT<>LASTVAL THEN LET TRANSITIONS=TRANSITIONS+1
410 LET LASTVAL=BIT
420 IF BIT=1 THEN LET HIGHS=HIGHS+1: ELSE LET LOWS=LOWS+1
430 LET SAMPLES=SAMPLES+1
440 NEXT I
450 CLS
460 PRINT AT 0,0; INK 5;"SIGNAL ANALYSIS"
470 PRINT "═══════════════════════════════"
480 PRINT
490 PRINT INK 6;"SAMPLES:      "; INK 7;SAMPLES
500 PRINT INK 6;"HIGH STATES:  "; INK 7;HIGHS
510 PRINT INK 6;"LOW STATES:   "; INK 7;LOWS
520 PRINT INK 6;"TRANSITIONS:  "; INK 7;TRANSITIONS
530 PRINT
540 PRINT INK 5;"WAVEFORM VISUALIZATION:"
550 PRINT "═══════════════════════"
560 REM ── DRAW WAVEFORM ──
570 FOR I=1 TO 32
580 LET IDX=I*8
590 IF IDX>256 THEN LET IDX=256
600 IF S(IDX)=1 THEN PRINT AT 14,I-1; INK 2;"▀": ELSE PRINT AT 15,I-1; INK 4;"▄"
610 NEXT I
620 PRINT
630 PRINT AT 17,0; INK 5;"FREQUENCY ESTIMATE:"
640 PRINT "════════════════════"
650 IF TRANSITIONS>0 THEN LET FREQ=INT(TRANSITIONS*3500000/(256*2)): PRINT INK 7;"~";FREQ;" HZ": ELSE PRINT INK 4;"NO SIGNAL"
660 PRINT
670 IF TRANSITIONS>100 THEN PRINT INK 2;"DATA STREAM DETECTED": GOTO 690
680 IF TRANSITIONS>20 THEN PRINT INK 6;"PILOT TONE DETECTED": ELSE PRINT INK 4;"SILENCE/NO INPUT"
690 PRINT
700 REM ── HEADER DECODE ATTEMPT ──
710 PRINT INK 5;"HEADER BYTE DECODE:"
720 PRINT "════════════════════"
730 LET BYTE=0
740 FOR I=1 TO 8
750 IF I*32<=256 THEN LET BYTE=BYTE+S(I*32)*2^(8-I)
760 NEXT I
770 PRINT INK 6;"FIRST BYTE: ";BYTE;" ($";
780 LET N=BYTE: GOSUB 2000
790 PRINT ")"
800 IF BYTE=0 THEN PRINT INK 2;"TYPE: HEADER BLOCK"
810 IF BYTE=255 THEN PRINT INK 2;"TYPE: DATA BLOCK"
820 PRINT
830 PRINT INK 7;"PRESS 'R' TO RESCAN OR ANY KEY TO EXIT"
840 PAUSE 0
850 LET K$=INKEY$
860 IF K$="r" OR K$="R" THEN GOTO 300
870 PRINT INK 6;"[NULLSEC RETRO SERIES]"
880 STOP
2000 REM ── HEX SUBROUTINE ──
2010 LET D=INT(N/16)
2020 PRINT CHR$(48+D+7*(D>9));
2030 LET D=N-16*INT(N/16)
2040 PRINT CHR$(48+D+7*(D>9));
2050 RETURN
