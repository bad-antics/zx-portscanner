10 REM ═══════════════════════════════════════
20 REM  ZX-MEMMAP V1.0
30 REM  MEMORY MAPPER FOR ZX SPECTRUM
40 REM  GITHUB.COM/BAD-ANTICS | NULLSEC RETRO
50 REM ═══════════════════════════════════════
60 REM
100 CLS
110 PRINT AT 0,0; INK 5;"╔════════════════════════════════╗"
120 PRINT AT 1,0; INK 5;"║"; INK 7;" ZX-MEMMAP V1.0        "; INK 5;"     ║"
130 PRINT AT 2,0; INK 5;"║"; INK 6;" MEMORY MAPPER/ANALYZER "; INK 5;"    ║"
140 PRINT AT 3,0; INK 5;"╚════════════════════════════════╝"
150 PRINT AT 5,0; INK 7;"ZX SPECTRUM MEMORY MAP:"
160 PRINT AT 6,0;"─────────────────────────────────"
170 PRINT AT 7,0; INK 4;"$0000-$3FFF "; INK 7;"ROM (16K)"
180 PRINT AT 8,0; INK 4;"$4000-$57FF "; INK 7;"DISPLAY FILE"
190 PRINT AT 9,0; INK 4;"$5800-$5AFF "; INK 7;"ATTRIBUTES"
200 PRINT AT 10,0; INK 4;"$5B00-$5BFF "; INK 7;"PRINTER BUFFER"
210 PRINT AT 11,0; INK 4;"$5C00-$5CBF "; INK 7;"SYSTEM VARS"
220 PRINT AT 12,0; INK 4;"$5CC0-$FF57 "; INK 7;"FREE RAM"
230 PRINT AT 13,0; INK 4;"$FF58-$FFFF "; INK 7;"UDG (128K: PAGING)"
240 PRINT
250 PRINT AT 15,0; INK 2;"SYSTEM VARIABLES:"
260 PRINT AT 16,0; INK 6;"RAMTOP: ";
270 LET RT=PEEK 23730+256*PEEK 23731
280 PRINT INK 7;RT;" ($";
290 GOSUB 2000: REM HEX OF RT
300 PRINT ")"
310 PRINT AT 17,0; INK 6;"PROG:   ";
320 LET PG=PEEK 23635+256*PEEK 23636
330 PRINT INK 7;PG
340 PRINT AT 18,0; INK 6;"VARS:   ";
350 LET VR=PEEK 23627+256*PEEK 23628
360 PRINT INK 7;VR
370 PRINT AT 19,0; INK 6;"E-LINE: ";
380 LET EL=PEEK 23641+256*PEEK 23642
390 PRINT INK 7;EL
400 PRINT AT 20,0; INK 6;"STKEND: ";
410 LET SE=PEEK 23653+256*PEEK 23654
420 PRINT INK 7;SE
430 PRINT
440 LET FREE=RT-SE
450 PRINT AT 22,0; INK 2;"FREE MEMORY: "; INK 7;FREE;" BYTES"
460 PRINT AT 23,0; INK 6;"PROG SIZE:   "; INK 7;VR-PG;" BYTES"
470 PRINT AT 24,0; INK 7;"PRESS ANY KEY FOR DEEP SCAN"
480 PAUSE 0
490 CLS
500 REM ── DEEP MEMORY SCAN ──
510 PRINT AT 0,0; INK 5;"DEEP MEMORY SCAN"
520 PRINT "════════════════════════════════"
530 PRINT
540 PRINT INK 6;"SCANNING 1K BLOCKS..."
550 PRINT
560 LET USED=0: LET EMPTY=0
570 FOR BLK=16384 TO RT-1 STEP 1024
580 LET SUM=0
590 FOR I=0 TO 15
600 LET SUM=SUM+PEEK(BLK+I*64)
610 NEXT I
620 IF SUM=0 THEN LET EMPTY=EMPTY+1: PRINT INK 4;".";: ELSE LET USED=USED+1: PRINT INK 2;"#";
630 NEXT BLK
640 PRINT
650 PRINT
660 PRINT INK 7;"USED BLOCKS: "; INK 2;USED
670 PRINT INK 7;"FREE BLOCKS: "; INK 4;EMPTY
680 PRINT
690 REM ── ROM SIGNATURE CHECK ──
700 PRINT INK 5;"ROM SIGNATURE CHECK"
710 PRINT "════════════════════"
720 LET R0=PEEK 0: LET R1=PEEK 1: LET R2=PEEK 2
730 PRINT INK 6;"BYTES 0-2: ";R0;" ";R1;" ";R2
740 IF R0=243 AND R1=175 AND R2=17 THEN PRINT INK 2;"48K ROM DETECTED": GOTO 770
750 IF R0=243 AND R1=1 THEN PRINT INK 2;"128K ROM DETECTED": GOTO 770
760 PRINT INK 4;"UNKNOWN ROM"
770 PRINT
780 REM ── ATTRIBUTE SCAN ──
790 PRINT INK 5;"SCREEN ATTRIBUTE ANALYSIS"
800 PRINT "═════════════════════════"
810 DIM C(8)
820 FOR I=22528 TO 23295
830 LET A=PEEK I
840 LET CL=A-8*INT(A/8)
850 LET C(CL+1)=C(CL+1)+1
860 NEXT I
870 FOR I=1 TO 8
880 PRINT INK 6;"INK ";I-1;": "; INK 7;C(I);" cells"
890 NEXT I
900 PRINT
910 PRINT INK 6;"[NULLSEC RETRO SERIES]"
920 STOP
2000 REM ── HEX CONVERSION SUBROUTINE ──
2010 LET N=RT: LET H$=""
2020 FOR I=1 TO 4
2030 LET D=N-16*INT(N/16)
2040 LET H$=CHR$(48+D+7*(D>9))+H$
2050 LET N=INT(N/16)
2060 NEXT I
2070 PRINT H$;
2080 RETURN
