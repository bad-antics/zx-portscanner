10 REM ═══════════════════════════════════════
20 REM  ZX-SCREENSPY V1.0
30 REM  DISPLAY FILE FORENSICS TOOL
40 REM  GITHUB.COM/BAD-ANTICS | NULLSEC RETRO
50 REM ═══════════════════════════════════════
60 REM
100 CLS
110 PRINT AT 0,0; INK 5;"╔════════════════════════════════╗"
120 PRINT AT 1,0; INK 5;"║"; INK 7;" ZX-SCREENSPY V1.0     "; INK 5;"     ║"
130 PRINT AT 2,0; INK 5;"║"; INK 6;" DISPLAY FILE FORENSICS "; INK 5;"    ║"
140 PRINT AT 3,0; INK 5;"╚════════════════════════════════╝"
150 PRINT
160 PRINT INK 7;"DISPLAY FILE LAYOUT:"
170 PRINT "─────────────────────"
180 PRINT INK 4;"$4000-$47FF  "; INK 7;"TOP THIRD (2K)"
190 PRINT INK 4;"$4800-$4FFF  "; INK 7;"MIDDLE THIRD (2K)"
200 PRINT INK 4;"$5000-$57FF  "; INK 7;"BOTTOM THIRD (2K)"
210 PRINT INK 4;"$5800-$5AFF  "; INK 7;"ATTRIBUTES (768B)"
220 PRINT
230 PRINT INK 2;"ANALYSIS OPTIONS:"
240 PRINT INK 7;"1 - PIXEL DENSITY SCAN"
250 PRINT INK 7;"2 - ATTRIBUTE ENTROPY"
260 PRINT INK 7;"3 - HIDDEN DATA CHECK"
270 PRINT INK 7;"4 - SCREEN HASH"
280 PRINT INK 7;"5 - FULL REPORT"
290 INPUT "CHOICE: ";CH
300 IF CH=1 THEN GOTO 400
310 IF CH=2 THEN GOTO 600
320 IF CH=3 THEN GOTO 800
330 IF CH=4 THEN GOTO 1000
340 IF CH=5 THEN GOTO 400
350 GOTO 230
400 REM ── PIXEL DENSITY SCAN ──
410 CLS
420 PRINT INK 5;"PIXEL DENSITY BY THIRD:"
430 PRINT "═══════════════════════"
440 PRINT
450 FOR THIRD=0 TO 2
460 LET BASE=16384+THIRD*2048
470 LET TOTAL=0: LET SET=0
480 FOR ADDR=BASE TO BASE+2047
490 LET B=PEEK ADDR
500 FOR BIT=0 TO 7
510 LET TOTAL=TOTAL+1
520 IF B AND 2^BIT THEN LET SET=SET+1
530 NEXT BIT
540 NEXT ADDR
550 LET PCT=INT(SET*100/TOTAL)
560 IF THIRD=0 THEN PRINT INK 6;"TOP:    ";
570 IF THIRD=1 THEN PRINT INK 6;"MIDDLE: ";
580 IF THIRD=2 THEN PRINT INK 6;"BOTTOM: ";
590 PRINT INK 7;SET;"/";TOTAL;" (";PCT;"%)"
595 REM DENSITY BAR
596 PRINT "  [";
597 FOR I=1 TO INT(PCT/5)
598 PRINT INK 2;"█";
599 NEXT I
601 FOR I=INT(PCT/5)+1 TO 20
602 PRINT INK 4;"░";
603 NEXT I
604 PRINT "]"
605 NEXT THIRD
606 PRINT
607 IF CH=5 THEN GOTO 600
608 GOTO 1200
600 REM ── ATTRIBUTE ENTROPY ──
610 CLS
620 PRINT INK 5;"ATTRIBUTE ENTROPY ANALYSIS:"
630 PRINT "═══════════════════════════"
640 PRINT
650 DIM F(256)
660 LET UNIQUE=0
670 FOR I=22528 TO 23295
680 LET A=PEEK I
690 LET F(A+1)=F(A+1)+1
700 IF F(A+1)=1 THEN LET UNIQUE=UNIQUE+1
710 NEXT I
720 PRINT INK 6;"UNIQUE ATTR VALUES: "; INK 7;UNIQUE;"/256"
730 PRINT
740 PRINT INK 6;"TOP ATTRIBUTES:"
750 PRINT "────────────────"
760 FOR RANK=1 TO 8
770 LET MAXV=0: LET MAXI=0
780 FOR I=1 TO 256
790 IF F(I)>MAXV THEN LET MAXV=F(I): LET MAXI=I-1
800 NEXT I
810 IF MAXV=0 THEN GOTO 850
815 LET INK_V=MAXI-8*INT(MAXI/8)
816 LET PAP_V=INT(MAXI/8)-8*INT(MAXI/64)
817 LET BR_V=INT(MAXI/64)-2*INT(MAXI/128)
818 LET FL_V=INT(MAXI/128)
820 PRINT INK 6;"$";: LET N=MAXI: GOSUB 2000
825 PRINT " COUNT:";MAXV;" INK:";INK_V;" PAPER:";PAP_V;" BR:";BR_V;" FL:";FL_V
830 LET F(MAXI+1)=0
840 NEXT RANK
850 PRINT
855 IF UNIQUE<3 THEN PRINT INK 2;"LOW ENTROPY - MOSTLY UNIFORM SCREEN"
856 IF UNIQUE>=3 AND UNIQUE<32 THEN PRINT INK 6;"MODERATE ENTROPY - STRUCTURED DISPLAY"
857 IF UNIQUE>=32 THEN PRINT INK 4;"HIGH ENTROPY - COMPLEX/GRAPHICAL"
860 IF CH=5 THEN GOTO 800
870 GOTO 1200
800 REM ── HIDDEN DATA CHECK ──
810 CLS
820 PRINT INK 5;"HIDDEN DATA SCAN:"
830 PRINT "═════════════════"
840 PRINT
845 PRINT INK 7;"Checking for data in invisible areas..."
846 PRINT
847 LET HIDDEN=0
850 REM Check flash-hidden (same INK/PAPER)
860 FOR I=22528 TO 23295
870 LET A=PEEK I
880 LET IK=A-8*INT(A/8)
890 LET PK=INT(A/8)-8*INT(A/64)
900 IF IK=PK THEN GOTO 950
910 GOTO 960
950 REM Check if corresponding screen bytes have data
952 LET OFFSET=I-22528
954 LET SCRADDR=16384+OFFSET
956 LET B=PEEK SCRADDR
958 IF B<>0 THEN LET HIDDEN=HIDDEN+1: IF HIDDEN<10 THEN PRINT INK 4;"  [$";: LET N=I: GOSUB 2000: PRINT "] INK=PAPER=";IK;" DATA=$";: LET N=B: GOSUB 2000: PRINT ""
960 NEXT I
970 PRINT
980 PRINT INK 6;"HIDDEN BYTES FOUND: "; INK 7;HIDDEN
990 IF HIDDEN>0 THEN PRINT INK 4;"[!] POSSIBLE STEGANOGRAPHY": ELSE PRINT INK 2;"[OK] NO HIDDEN DATA"
995 IF CH=5 THEN GOTO 1000
996 GOTO 1200
1000 REM ── SCREEN HASH ──
1010 CLS
1020 PRINT INK 5;"SCREEN HASH:"
1030 PRINT "════════════"
1040 PRINT
1050 LET HASH=0
1060 FOR I=16384 TO 23295
1070 LET B=PEEK I
1080 LET HASH=HASH+B*((I-16384)+1)
1090 LET HASH=HASH-65536*INT(HASH/65536)
1100 NEXT I
1110 PRINT INK 6;"CHECKSUM: "; INK 7;HASH
1120 PRINT INK 6;"HEX:      $";: LET N=HASH: GOSUB 2000: PRINT ""
1130 PRINT
1140 PRINT INK 7;"Use this hash to detect screen changes"
1150 PRINT INK 7;"between scan sessions."
1200 PRINT
1210 PRINT INK 7;"PRESS ANY KEY TO RETURN"
1220 PAUSE 0
1230 GOTO 100
2000 REM ── HEX SUBROUTINE ──
2010 LET H$=""
2020 LET TN=N
2030 FOR HI=1 TO 4
2040 LET D=TN-16*INT(TN/16)
2050 LET H$=CHR$(48+D+7*(D>9))+H$
2060 LET TN=INT(TN/16)
2070 NEXT HI
2080 PRINT H$;
2090 RETURN
