10 REM ═══════════════════════════════════════
20 REM  ZX-PORTSCANNER V1.0
30 REM  SINCLAIR ZX SPECTRUM I/O PORT SCANNER
40 REM  GITHUB.COM/BAD-ANTICS | NULLSEC RETRO
50 REM ═══════════════════════════════════════
60 REM
100 CLS
110 PRINT AT 0,0; INK 5;"╔════════════════════════════════╗"
120 PRINT AT 1,0; INK 5;"║"; INK 7;" ZX-PORTSCANNER V1.0 "; INK 5;"       ║"
130 PRINT AT 2,0; INK 5;"║"; INK 6;" I/O PORT ANALYZER    "; INK 5;"       ║"
140 PRINT AT 3,0; INK 5;"╚════════════════════════════════╝"
150 PRINT AT 5,0; INK 7;"ZX SPECTRUM I/O PORTS:"
160 PRINT AT 6,0;"─────────────────────────────────"
170 PRINT AT 7,0; INK 4;"$FE    "; INK 7;"ULA (KEYBOARD/TAPE/SPEAKER)"
180 PRINT AT 8,0; INK 4;"$FF    "; INK 7;"FLOATING BUS"
190 PRINT AT 9,0; INK 4;"$7FFD  "; INK 7;"128K MEMORY PAGING"
200 PRINT AT 10,0; INK 4;"$BFFD  "; INK 7;"AY-3-8912 DATA"
210 PRINT AT 11,0; INK 4;"$FFFD  "; INK 7;"AY-3-8912 REGISTER"
220 PRINT AT 12,0; INK 4;"$1FFD  "; INK 7;"+3 DISK/PRINTER"
230 PRINT
240 PRINT AT 14,0; INK 2;"SCANNING STANDARD PORTS..."
250 PRINT
300 REM SCAN KEYBOARD PORTS
310 FOR ROW=0 TO 7
320 LET ADDR=254+256*(255-2^ROW)
330 LET V=IN ADDR
340 PRINT AT 16+ROW,0; INK 6;"ROW ";ROW;": PORT $";
350 LET H$="": LET N=ADDR
360 FOR I=1 TO 4
370 LET D=N-16*INT(N/16)
380 LET H$=CHR$(48+D+7*(D>9))+H$
390 LET N=INT(N/16)
400 NEXT I
410 PRINT H$;" = ";
420 REM BINARY OUTPUT
430 FOR B=7 TO 0 STEP -1
440 IF V AND 2^B THEN PRINT INK 2;"1";:ELSE PRINT INK 4;"0";
450 NEXT B
460 PRINT " (";V;")"
470 NEXT ROW
480 PRINT
490 PRINT AT 25,0; INK 7;"PRESS ANY KEY FOR FULL SCAN"
500 PAUSE 0
510 CLS
600 REM FULL PORT SCAN
610 PRINT AT 0,0; INK 5;"SCANNING ALL 256 BASE PORTS..."
620 PRINT
630 LET COUNT=0
640 FOR P=0 TO 255
650 LET V=IN P
660 IF V<>255 THEN LET COUNT=COUNT+1: PRINT INK 4;"PORT ";P;": "; INK 7;V
670 NEXT P
680 PRINT
690 PRINT INK 2;"ACTIVE PORTS FOUND: ";COUNT
700 PRINT
710 PRINT INK 6;"[NULLSEC RETRO SERIES]"
720 STOP
